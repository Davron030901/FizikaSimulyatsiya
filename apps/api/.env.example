# --- Server ---
NODE_ENV=development
PORT=4000

# --- CORS ---
# Frontend manzili (Vercel URL yoki localhost)
FRONTEND_URL=http://localhost:3000
# Qo'shimcha ruxsat etilgan originlar (vergul bilan ajratilgan)
CORS_EXTRA_ORIGINS=

# --- Auth (admin panel) ---
# Ishlab chiqarishda albatta o'zgartiring: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please-32-chars
JWT_EXPIRES_IN=7d

# --- Birinchi admin hisobi (ixtiyoriy) ---
# To'ldirilsa, `npm run seed` admin hisobini ham yaratadi.
# Bo'sh qoldirsangiz, keyinroq `npm run create:admin` bilan qo'shasiz.
# Parol kamida 8 ta belgi bo'lishi kerak.
ADMIN_EMAIL=admin@physicslab.uz
ADMIN_PASSWORD=change-me-strong-password

# --- Database (MAJBURIY) ---
#
# Eng oson yo'l - bepul bulutli baza (Windows uchun ham qulay):
#   1. neon.tech da ro'yxatdan o'ting, Frankfurt regionida loyiha oching
#   2. "Connection string" ni nusxalab, quyidagi qatorga qo'ying
#   DATABASE_URL=postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Yoki lokal Docker (bitta qatorda, PowerShell'da ham ishlaydi):
#   docker run --name physicslab-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=physicslab -p 5432:5432 -d postgres:16
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/physicslab?schema=public
