# --- Server ---
NODE_ENV=development
PORT=4000

# --- CORS ---
# Frontend manzili (Vercel URL yoki localhost)
FRONTEND_URL=http://localhost:3000
# Qo'shimcha ruxsat etilgan originlar (vergul bilan ajratilgan)
CORS_EXTRA_ORIGINS=

# --- Auth (admin panel) ---
# Ishlab chiqarishda albatta o'zgartiring: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please-32-chars
JWT_EXPIRES_IN=7d

# --- Birinchi admin hisobi (npm run create:admin uchun) ---
ADMIN_EMAIL=admin@physicslab.uz
ADMIN_PASSWORD=change-me-strong-password

# --- Database (MAJBURIY) ---
# Lokal Docker:  docker run --name physicslab-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=physicslab -p 5432:5432 -d postgres:16
# Yoki bepul bulutli baza: neon.tech / render.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/physicslab?schema=public
