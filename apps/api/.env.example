# --- Server ---
NODE_ENV=development
PORT=4000

# --- CORS ---
# Frontend manzili (Vercel URL yoki localhost)
FRONTEND_URL=http://localhost:3000
# Qo'shimcha ruxsat etilgan originlar (vergul bilan ajratilgan)
CORS_EXTRA_ORIGINS=

# --- Auth (admin panel) ---
# Ishlab chiqarishda albatta o'zgartiring: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please-32-chars
JWT_EXPIRES_IN=7d

# --- Birinchi admin hisobi (ixtiyoriy) ---
# To'ldirilsa, `npm run seed` admin hisobini ham yaratadi.
# Bo'sh qoldirsangiz, keyinroq `npm run create:admin` bilan qo'shasiz.
# Parol kamida 8 ta belgi bo'lishi kerak.
ADMIN_EMAIL=admin@physicslab.uz
ADMIN_PASSWORD=change-me-strong-password

# =====================================================================
#  BAZA — ikkita manzil kerak
# =====================================================================
#
#  DATABASE_URL  -> ilova so'rovlari uchun
#  DIRECT_URL    -> migratsiyalar uchun (poolersiz)
#
#  Oddiy PostgreSQL yoki Neon'da ikkalasi BIR XIL bo'lishi mumkin.
#  Supabase'da esa ular ALBATTA farq qiladi (pastga qarang).
#
# ---------------------------------------------------------------------
#  A) SUPABASE (bepul, tavsiya etiladi)
# ---------------------------------------------------------------------
#  Dashboard -> yuqoridagi "Connect" tugmasi -> "ORM" -> "Prisma"
#  U yerda ikkala satr tayyor holda beriladi. Namuna:
#
#  DATABASE_URL="postgresql://postgres.abcdefgh:PAROL@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#  DIRECT_URL="postgresql://postgres.abcdefgh:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
#
#  Diqqat:
#   * 6543 = transaction pooler (ilova),  5432 = session pooler (migratsiya)
#   * `postgresql+asyncpg://` emas, oddiy `postgresql://` bo'lishi kerak
#   * Parolda maxsus belgi bo'lsa, uni URL-kodlang (@ -> %40, # -> %23)
#
# ---------------------------------------------------------------------
#  B) NEON (bepul, muddatsiz)
# ---------------------------------------------------------------------
#  DATABASE_URL="postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/physicslab?sslmode=require"
#  DIRECT_URL="postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/physicslab?sslmode=require"
#
# ---------------------------------------------------------------------
#  C) LOKAL DOCKER (bitta qatorda, PowerShell'da ham ishlaydi)
# ---------------------------------------------------------------------
#  docker run --name physicslab-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=physicslab -p 5432:5432 -d postgres:16
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/physicslab
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/physicslab
