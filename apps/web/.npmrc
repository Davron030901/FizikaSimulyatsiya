# Render/Heroku kabi platformalar NODE_ENV=production o'rnatadi, npm esa bu holatda
# devDependencies'ni o'tkazib yuboradi. Lekin build uchun typescript va @types/*,
# seed uchun esa tsx aynan devDependencies ichida. Shu sabab ularni majburan yoqamiz.
#
# `include` — zamonaviy kalit, `production=false` — eski npm versiyalari uchun zaxira.
include=dev
production=false
